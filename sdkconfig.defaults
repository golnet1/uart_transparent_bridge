CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"

CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_FREERTOS_HZ=1000
# HTTP + WebSocket + Telnet + OTA: больше сокетов, иначе веб «залипает»
CONFIG_LWIP_MAX_SOCKETS=16

# NTP: синхронизация часов и реальное время в журнале
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# UART0 используется нами для USB-зеркала и команд, системный консольный драйвер не нужен
CONFIG_ESP_CONSOLE_NONE=y

# HTTPS OTA (опционально). Для HTTP-ссылок не обязательно.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Немного больше места для HTTP/telnet/OTA
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
